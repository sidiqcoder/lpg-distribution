{
  "name": "lpg-distribution-app",
  "version": "1.0.0",
  "description": "Frontend React untuk Vercel dengan API, database dan storage di Supabase",
  "private": true,
  "scripts": {
    "start": "npm --prefix client run dev",
    "dev": "npm --prefix client run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "migrate:prepare": "node scripts/prepare-migration.js",
    "migrate:uploads": "node scripts/migrate-uploads.js",
    "check:backend": "deno check --config supabase/functions/lpg-api/deno.json supabase/functions/lpg-api/index.ts",
    "test": "npm --prefix client run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.6",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "supabase": "2.120.0"
  }
}
